rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Player accounts: anyone logged in can look (needed for trading), only you can change yours.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.points == 150
                    && request.resource.data.abilities.size() == 0
                    && request.resource.data.skins.size() == 0;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.username == resource.data.username
                    && request.resource.data.points is number
                    && request.resource.data.points >= 0;
      allow delete: if false;
    }

    // username -> account, so you can find people to trade with. Can't be taken over.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Trades: only the two people in a trade can see it.
    match /trades/{id} {
      allow read: if request.auth != null
                  && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to != request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                    && (
                      // the person receiving the trade answers it
                      (resource.data.to == request.auth.uid && resource.data.status == 'pending'
                         && request.resource.data.status in ['accepted', 'declined'])
                      // the sender cancels, or collects afterwards
                      || (resource.data.from == request.auth.uid && (
                           (resource.data.status == 'pending'  && request.resource.data.status == 'cancelled')
                        || (resource.data.status == 'accepted' && request.resource.data.status == 'done')
                        || (resource.data.status == 'declined' && request.resource.data.status == 'closed')))
                    );
      allow delete: if false;
    }
  }
}
